{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "biophys-agent",
  "version": "0.1.0",
  "identifier": "com.minseok.biophys-agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "BioPhys Agent OS",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
